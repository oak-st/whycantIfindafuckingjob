# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Login credentials for the web UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Auto-generated on first run if left blank — safe to leave empty
JWT_SECRET=
ENCRYPTION_KEY=

# Anthropic API key (optional — can also be set via the Settings page in the UI)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: set to "true" to show browser window during crawling (useful for debugging)
# HEADLESS=true
